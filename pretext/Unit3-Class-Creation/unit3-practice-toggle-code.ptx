<section xml:id="unit3-practice-toggle-code">
  <title>Toggle Code Practice 3 (3.4-3.9)</title>

  <p>
    Write your own solution for each problem below and click Run to check it.
    If you get stuck, click the <em>Pathfinder</em> button (the compass) on the
    problem for step-by-step hints and a mixed up code puzzle that can help you finish.
  </p>

  <exercise label="u3_ct_wc1" xml:id="u3_ct_wc1">
    <title>Constructors and toString</title>

    <statement>
      <p>
        Write a constructor for the <c>Student</c> class. It takes a <c>name</c> (a <c>String</c>), a <c>grade</c> (an <c>int</c>), and a <c>gpa</c> (a <c>double</c>), in that order, and sets the matching instance variables. Then write a <c>toString</c> method that returns the student's information in the form <c>name (grade grade): gpa</c>, for example <c>Ana (grade 10): 3.8</c>.
      </p>
    </statement>

    <program interactive="activecode" language="java" label="u3_ct_wc1-prog" xml:id="u3_ct_wc1-prog"
             codetailor="all" codetailor-fallback="u3_ct_muc1">
      <code>
public class Student
{
    private String name;
    private int grade;
    private double gpa;

    // YOUR CODE HERE

    public static void main(String[] args)
    {
        Student s = new Student("Ana", 10, 3.8);
        System.out.println(s);
    }
}
      </code>
      <tests>
import static org.junit.Assert.*;

import org.junit.*;

import java.io.*;

public class RunestoneTests extends CodeTestHelper
{
    public RunestoneTests()
    {
        super("Student");
    }

    @Test
    public void testMain()
    {
        String output = getMethodOutput("main");
        String expect = "Ana (grade 10): 3.8";
        boolean passed = getResults(expect, output, "Expected output from main");
        assertTrue(passed);
    }

    @Test
    public void testToString1()
    {
        Object[] args = {"Ben", 9, 2.5};
        setDefaultValues(args);
        String output = "" + getMethodOutput("toString");
        boolean passed = getResults("Ben (grade 9): 2.5", output, "toString() with constructor arguments {\"Ben\", 9, 2.5}");
        assertTrue(passed);
    }
}

      </tests>
    </program>
  </exercise>

  <exercise label="u3_ct_wc2" xml:id="u3_ct_wc2">
    <title>Methods that return a value</title>

    <statement>
      <p>
        Write a <c>getPrice</c> method for the <c>Ticket</c> class. It returns <c>5</c> if <c>age</c> is under 12, and <c>10</c> otherwise.
      </p>
    </statement>

    <program interactive="activecode" language="java" label="u3_ct_wc2-prog" xml:id="u3_ct_wc2-prog"
             codetailor="all" codetailor-fallback="u3_ct_muc2">
      <code>
public class Ticket
{
    private int age;

    public Ticket(int age)
    {
        this.age = age;
    }

    // YOUR CODE HERE

    public static void main(String[] args)
    {
        System.out.println(new Ticket(8).getPrice());
        System.out.println(new Ticket(12).getPrice());
        System.out.println(new Ticket(40).getPrice());
    }
}
      </code>
      <tests>
import static org.junit.Assert.*;

import org.junit.*;

import java.io.*;

public class RunestoneTests extends CodeTestHelper
{
    public RunestoneTests()
    {
        super("Ticket");
    }

    @Test
    public void testMain()
    {
        String output = getMethodOutput("main");
        String expect = "5\n10\n10";
        boolean passed = getResults(expect, output, "Expected output from main");
        assertTrue(passed);
    }

    @Test
    public void testGetPrice1()
    {
        Object[] args = {11};
        setDefaultValues(args);
        String output = "" + getMethodOutput("getPrice");
        boolean passed = getResults("5", output, "getPrice() with constructor arguments {11}");
        assertTrue(passed);
    }

    @Test
    public void testGetPrice2()
    {
        Object[] args = {65};
        setDefaultValues(args);
        String output = "" + getMethodOutput("getPrice");
        boolean passed = getResults("10", output, "getPrice() with constructor arguments {65}");
        assertTrue(passed);
    }
}

      </tests>
    </program>
  </exercise>

  <exercise label="u3_ct_wc3" xml:id="u3_ct_wc3">
    <title>Methods that change an object</title>

    <statement>
      <p>
        Write a <c>withdraw</c> method for the <c>BankAccount</c> class. It takes an <c>int</c> <c>amount</c>. If the account has at least that much money, subtract <c>amount</c> from <c>balance</c>. Otherwise, leave <c>balance</c> unchanged.
      </p>
    </statement>

    <program interactive="activecode" language="java" label="u3_ct_wc3-prog" xml:id="u3_ct_wc3-prog"
             codetailor="all" codetailor-fallback="u3_ct_muc3">
      <code>
public class BankAccount
{
    private int balance;

    public BankAccount(int balance)
    {
        this.balance = balance;
    }

    public int getBalance()
    {
        return balance;
    }

    // YOUR CODE HERE

    public static void main(String[] args)
    {
        BankAccount acct = new BankAccount(100);
        acct.withdraw(30);
        System.out.println(acct.getBalance());
        acct.withdraw(200);
        System.out.println(acct.getBalance());
        acct.withdraw(70);
        System.out.println(acct.getBalance());
    }
}
      </code>
      <tests>
import static org.junit.Assert.*;

import org.junit.*;

import java.io.*;

public class RunestoneTests extends CodeTestHelper
{
    public RunestoneTests()
    {
        super("BankAccount");
    }

    @Test
    public void testMain()
    {
        String output = getMethodOutput("main");
        String expect = "70\n70\n0";
        boolean passed = getResults(expect, output, "Expected output from main");
        assertTrue(passed);
    }
}

      </tests>
    </program>
  </exercise>

  <exercise label="u3_ct_wc4" xml:id="u3_ct_wc4">
    <title>Objects as parameters and this</title>

    <statement>
      <p>
        Write two methods for the <c>Rectangle</c> class. <c>getArea</c> returns <c>width</c> times <c>height</c>. <c>isLargerThan</c> takes another <c>Rectangle</c> and returns <c>true</c> if this rectangle's area is larger than the other rectangle's area.
      </p>
    </statement>

    <program interactive="activecode" language="java" label="u3_ct_wc4-prog" xml:id="u3_ct_wc4-prog"
             codetailor="all" codetailor-fallback="u3_ct_muc4">
      <code>
public class Rectangle
{
    private int width;
    private int height;

    public Rectangle(int width, int height)
    {
        this.width = width;
        this.height = height;
    }

    // YOUR CODE HERE

    public static void main(String[] args)
    {
        Rectangle a = new Rectangle(4, 5);
        Rectangle b = new Rectangle(3, 6);
        System.out.println(a.getArea());
        System.out.println(a.isLargerThan(b));
        System.out.println(b.isLargerThan(a));
    }
}
      </code>
      <tests>
import static org.junit.Assert.*;

import org.junit.*;

import java.io.*;

public class RunestoneTests extends CodeTestHelper
{
    public RunestoneTests()
    {
        super("Rectangle");
    }

    @Test
    public void testMain()
    {
        String output = getMethodOutput("main");
        String expect = "20\ntrue\nfalse";
        boolean passed = getResults(expect, output, "Expected output from main");
        assertTrue(passed);
    }

    @Test
    public void testGetArea1()
    {
        Object[] args = {2, 7};
        setDefaultValues(args);
        String output = "" + getMethodOutput("getArea");
        boolean passed = getResults("14", output, "getArea() with constructor arguments {2, 7}");
        assertTrue(passed);
    }
}

      </tests>
    </program>
  </exercise>

  <exercise label="u3_ct_wc5" xml:id="u3_ct_wc5">
    <title>Static variables and methods</title>

    <statement>
      <p>
        Every <c>PizzaOrder</c> shares the same price per slice, stored in the static variable <c>pricePerSlice</c>. Write a static method <c>setPricePerSlice</c> that takes a <c>double</c> <c>price</c> and changes <c>pricePerSlice</c> to it. Then write a <c>getTotal</c> method that returns the order's total cost: <c>slices</c> times <c>pricePerSlice</c>.
      </p>
    </statement>

    <program interactive="activecode" language="java" label="u3_ct_wc5-prog" xml:id="u3_ct_wc5-prog"
             codetailor="all" codetailor-fallback="u3_ct_muc5">
      <code>
public class PizzaOrder
{
    private int slices;
    private static double pricePerSlice = 2.0;

    public PizzaOrder(int slices)
    {
        this.slices = slices;
    }

    // YOUR CODE HERE

    public static void main(String[] args)
    {
        PizzaOrder small = new PizzaOrder(2);
        PizzaOrder large = new PizzaOrder(6);
        PizzaOrder.setPricePerSlice(2.5);
        System.out.println(small.getTotal());
        System.out.println(large.getTotal());
        PizzaOrder.setPricePerSlice(3.0);
        System.out.println(small.getTotal());
        System.out.println(large.getTotal());
    }
}
      </code>
      <tests>
import static org.junit.Assert.*;

import org.junit.*;

import java.io.*;

public class RunestoneTests extends CodeTestHelper
{
    public RunestoneTests()
    {
        super("PizzaOrder");
    }

    @Test
    public void testMain()
    {
        String output = getMethodOutput("main");
        String expect = "5.0\n15.0\n6.0\n18.0";
        boolean passed = getResults(expect, output, "Expected output from main");
        assertTrue(passed);
    }
}

      </tests>
    </program>
  </exercise>

</section>
